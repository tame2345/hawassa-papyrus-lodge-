rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global safety net - default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Common helper primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Profile Validation Helper
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'fullName', 'email', 'createdAt'])
        && data.keys().size() >= 4
        && data.uid is string && data.uid.size() <= 128
        && data.fullName is string && data.fullName.size() <= 100
        && data.email is string && data.email.size() <= 100
        && data.createdAt == request.time;
    }

    // User File Validation Helper
    function isValidUserFile(data) {
      return data.keys().hasAll(['id', 'userId', 'fileName', 'fileSize', 'fileType', 'uploadedAt', 'fileContent'])
        && data.keys().size() >= 7
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.userId == request.auth.uid
        && data.fileName is string && data.fileName.size() <= 200
        && data.fileSize is int && data.fileSize >= 0 && data.fileSize <= 15000000
        && data.fileType is string && data.fileType.size() <= 100
        && data.uploadedAt == request.time
        && data.fileContent is string && data.fileContent.size() <= 15000000
        && (!data.keys().hasAny(['description']) || (data.description is string && data.description.size() <= 5000))
        && (!data.keys().hasAny(['employeeId']) || (data.employeeId is string && data.employeeId.size() <= 128));
    }

    // User Note Validation Helper
    function isValidUserNote(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'content'])
        && data.keys().size() >= 4
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.userId == request.auth.uid
        && data.title is string && data.title.size() <= 200
        && data.content is string && data.content.size() <= 20000;
    }

    // Team Member Validation Helper
    function isValidTeamMember(data) {
      return data.keys().hasAll(['id', 'userId', 'name', 'role', 'status'])
        && data.keys().size() >= 5
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.userId == request.auth.uid
        && data.name is string && data.name.size() <= 100
        && data.role is string && data.role.size() <= 100
        && data.status is string && data.status.size() <= 50;
    }

    // Users Collection Rule
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) 
        && isValidUser(request.resource.data)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName', 'phone']);
      allow delete: if false; // Users cannot be deleted from rules right now
    }

    // User Files Collection Rule
    match /user_files/{fileId} {
      allow get, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() 
        && isValidId(fileId) 
        && fileId == request.resource.data.id
        && isValidUserFile(request.resource.data);

      allow update: if isSignedIn() 
        && resource.data.userId == request.auth.uid
        && isValidUserFile(request.resource.data)
        && request.resource.data.id == resource.data.id
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.uploadedAt == resource.data.uploadedAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fileName', 'description', 'employeeId']);
    }

    // User Notes Collection Rule
    match /user_notes/{noteId} {
      allow get, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() 
        && isValidId(noteId) 
        && noteId == request.resource.data.id
        && isValidUserNote(request.resource.data);

      allow update: if isSignedIn() 
        && resource.data.userId == request.auth.uid
        && isValidUserNote(request.resource.data)
        && request.resource.data.id == resource.data.id
        && request.resource.data.userId == resource.data.userId;
    }

    // Team Members Collection Rule
    match /user_team_members/{memberId} {
      allow get, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() 
        && isValidId(memberId) 
        && memberId == request.resource.data.id
        && isValidTeamMember(request.resource.data);

      allow update: if isSignedIn() 
        && resource.data.userId == request.auth.uid
        && isValidTeamMember(request.resource.data)
        && request.resource.data.id == resource.data.id
        && request.resource.data.userId == resource.data.userId;
    }
  }
}
